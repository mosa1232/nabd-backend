# {$DOMAIN::80}: with a real domain Caddy gets and renews a free HTTPS
# certificate by itself; with no domain set it just serves plain HTTP on :80
# (useful for a first test by IP address).
#
# The site is the React app (built into web/dist and committed, so the server
# needs no Node). API paths go to the FastAPI backend; everything else is the
# single-page app. The previous single-file apps stay reachable at /legacy
# (students) and /admin-legacy (dashboard) as a fallback.

(react_site) {
	encode zstd gzip

	# The biggest upload the app accepts is a 150 MB lecture video.
	request_body {
		max_size 160MB
	}

	@backend path /api/* /auth/* /media-files/* /static/* /health /favicon.ico /legacy /admin-legacy
	handle @backend {
		reverse_proxy app:8000 {
			# a sleepy first request after a restart should not become a 502
			lb_try_duration 10s
			health_uri /health
			health_interval 15s
		}
	}

	# if the backend is down or restarting, API callers still get JSON
	handle_errors {
		@api path /api/* /auth/* /media-files/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"detail":"الخدمة غير متاحة مؤقتاً، حاول بعد لحظات"}` {err.status_code}
		}
	}

	# the built files: a missing one is a real 404, never the app page in disguise
	@assets path /assets/*
	handle @assets {
		root * /srv/beta
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/beta
		# every page of the app is index.html (also for "/" and deep links): never cached, so a deploy is
		# picked up at once and a stale copy can't point at hashed files that were replaced
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header @page Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'"
		header @page Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		header @page Cross-Origin-Opener-Policy "same-origin-allow-popups"
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN::80} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	import react_site
}

# One address per language: the same React app; the address decides the language
# (kiur.online = Arabic, en.kiur.online = English, ku.kiur.online = Kurdish).
# Set LANG_DOMAINS in .env to "en.kiur.online, ku.kiur.online, ar.kiur.online" once their DNS records
# point at this server; left unset, nothing extra is served.
{$LANG_DOMAINS::8082} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	import react_site
}

# beta.<domain>: the same React app, kept out of search engines. Leave
# BETA_DOMAIN unset to keep it internal-only (:8081).
{$BETA_DOMAIN::8081} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	import react_site
}