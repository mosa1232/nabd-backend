# Copy this file to .env and fill in real values.

# SQLite for local dev — swap for Postgres in production, e.g.
# postgresql+psycopg://user:password@localhost:5432/nabd
DATABASE_URL=sqlite:///./nabd.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# From https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (type: Web application)
# 2. Add this exact URL under "Authorized redirect URIs":
#    http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Restrict sign-in to university email domains, comma-separated.
# Leave empty during development to allow any Google account.
ALLOWED_UNIVERSITY_DOMAINS=uob.edu.iq

# Where the API should send the browser back to after login
FRONTEND_URL=http://localhost:5500

# Origins allowed to call this API (the URL the frontend HTML is served from)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Enables POST /auth/dev-login, a stand-in for the Google flow so you can
# test everything else before wiring real OAuth credentials.
DEBUG=true
