# Copy this file to .env and fill in real values.

# SQLite for local dev — swap for Postgres in production, e.g.
# postgresql+psycopg://user:password@localhost:5432/nabd
DATABASE_URL=sqlite:///./nabd.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# The one email allowed to become admin while the platform has no admin
# yet. Leave empty to disable auto-promotion entirely.
BOOTSTRAP_ADMIN_EMAIL=

# From https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (type: Web application)
# 2. Add this exact URL under "Authorized redirect URIs":
#    http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Restrict sign-in to university email domains, comma-separated.
# Leave empty during development to allow any Google account.
ALLOWED_UNIVERSITY_DOMAINS=uob.edu.iq

# Where the API should send the browser back to after a student's Google
# sign-in.
FRONTEND_URL=http://localhost:5500

# Where an admin/professor/reseller Google sign-in (the "الدخول عبر Google"
# button on the admin dashboard's login screen) lands instead. Leave empty —
# this app serves the dashboard itself at /admin, so it's derived from
# whatever origin the sign-in was started from and just works, locally and
# in production alike. Only set this if the dashboard is hosted somewhere
# this app doesn't serve it.
ADMIN_FRONTEND_URL=

# Origins allowed to call this API (the URL the frontend HTML is served from)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Enables POST /auth/dev-login, a stand-in for the Google flow so you can
# test everything else before wiring real OAuth credentials.
DEBUG=true

# Outgoing email. Password reset is the only thing that sends mail, and it
# refuses to pretend: with SMTP_HOST empty, "نسيت كلمة المرور" answers 503
# and says the server can't send, instead of showing "check your inbox" for
# a message that never left.
#
# Plain SMTP, so any provider works. A few hosts/ports:
#   Gmail    smtp.gmail.com:587       (needs an App Password, not the login one)
#   Brevo    smtp-relay.brevo.com:587
#   Zoho     smtp.zoho.com:465
#   Resend   smtp.resend.com:587      (user: "resend", password: the API key)
#   Mailgun  smtp.mailgun.org:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=Kiur
# Leave true. Only turn it off for a local relay (MailHog/Mailpit) — sending
# a password in the clear to a remote host is refused outright.
SMTP_USE_TLS=true

# How long a reset link lives, and the gap enforced between two requests for
# the same address so nobody's inbox can be flooded through this endpoint.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=120

# Where uploaded booklets, lecture videos and photos are stored.
# "local" writes to ./uploads — fine for development, but that directory is
# wiped on every deploy on a host with an ephemeral disk. "s3" works with any
# S3-compatible store: Cloudflare R2, AWS S3, Backblaze B2, Supabase, MinIO.
STORAGE_BACKEND=local
# S3_BUCKET=nabd-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=uploads
# Leave S3_PUBLIC_BASE_URL empty to hand out short-lived signed URLs (the
# right default for paid booklets and videos). Set it only if the bucket or
# a CDN in front of it is public.
# S3_PUBLIC_BASE_URL=
