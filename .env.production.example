# Copy to .env on the server (deploy/setup-oracle.sh does this for you and fills
# in the secrets). Never commit the real .env.

# ---- required ----
# Your domain (leave empty to test over plain HTTP by IP address first).
DOMAIN=
# Generated by the setup script — a long random value.
POSTGRES_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__

# The one email that becomes admin when the platform has no admin yet.
BOOTSTRAP_ADMIN_EMAIL=

# ---- AI (optional) ----
# https://console.anthropic.com → API keys. Empty = the assistant works in
# question-bank search mode only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- sign-in with Google (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://YOUR-DOMAIN/auth/google/callback
GOOGLE_REDIRECT_URI=
# https://YOUR-DOMAIN
FRONTEND_URL=
CORS_ORIGINS=

# ---- password-reset email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- storage / database overrides (optional) ----
# Files stay on this server's disk (a Docker volume) by default.
STORAGE_BACKEND=local
# Use an outside database instead of the bundled PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# How many daily database backups to keep in ./backups
BACKUP_KEEP_DAYS=14
